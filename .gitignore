```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.tsbuildinfo

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.nyc_output/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Python related
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db

# Testing
.jest/
.nyc_output/
.coverage
coverage.xml
*.lcov

# Distribution / packaging
.Python
*.so
.libs/
.pytest_cache/
.mypy_cache/
tox.ini
.coveragerc

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```